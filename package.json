{
	"name": "@jalalix/mui",
	"version": "0.2.0",
	"private": false,
	"main": "index.js",
	"module": "index.js",
	"types": "index.d.ts",
	"description": "Jalali adapter for MUI X Date Pickers using @jalalix/typescript",
	"author": "Hossein Maklavani <hos.mohamadi@gmail.com> (https://maklavani.dev)",
	"contributors": [
		{
			"name": "Hossein Maklavani",
			"email": "hos.mohamadi@gmail.com",
			"url": "https://maklavani.dev"
		}
	],
	"license": "MIT",
	"keywords": [
		"mui",
		"mui-x",
		"date-pickers",
		"jalali",
		"jalalix",
		"persian",
		"shamsi",
		"khorshidi",
		"calendar",
		"date",
		"typescript",
		"react"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jalalix/mui.git"
	},
	"funding": [
		{
			"type": "open_collective",
			"url": "https://opencollective.com/jalalix"
		}
	],
	"bugs": {
		"url": "https://github.com/jalalix/mui/issues"
	},
	"homepage": "https://jalalix.com",
	"scripts": {
		"dev": "nodemon --exec \"node --experimental-strip-types\" src/index.ts",
		"build": "npm run remove && tsc -p tsconfig.json",
		"remove": "node scripts/remove.mjs",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@jalalix/typescript": "^0.9.0"
	},
	"peerDependencies": {
		"@mui/x-date-pickers": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0",
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@mui/x-date-pickers": "^9.18.0",
		"@types/react": "^19.0.0",
		"nodemon": "^3.1.14",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"require": "./index.js",
			"import": "./index.js",
			"default": "./index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"AdapterJalaliX.d.ts",
		"AdapterJalaliX.js",
		"index.d.ts",
		"index.js",
		"index.types.d.ts",
		"index.types.js",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
